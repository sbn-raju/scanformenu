NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase Postgres — Dashboard → Connect → Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ImageKit — Dashboard → Developer options → API keys
# The private key signs uploads and calls the ImageKit API. Never expose it to the browser.
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
# e.g. https://ik.imagekit.io/your_imagekit_id
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# Public address printed into QR codes, e.g. https://scanformenu.com (no trailing slash).
# Leave empty in development to use the address you open the app on.
NEXT_PUBLIC_APP_URL=

# Upstash Redis — Console → your database → REST API. Caches menus, users and
# QR redirects in front of Postgres. Optional: leave empty to read straight
# from the database (handy in local development).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
